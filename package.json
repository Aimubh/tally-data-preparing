{
  "name": "group-mis",
  "version": "0.1.0",
  "private": true,
  "description": "Consolidation MIS for a business group — Tally-export ingestion, inter-company elimination, company-scoped reports.",
  "scripts": {
    "dev": "next dev -p 3400",
    "build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start -p 3400",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "seed:clear": "tsx prisma/seed.ts --clear"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
